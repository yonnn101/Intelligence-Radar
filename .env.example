# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=replace_me

# Gemini API key for summaries and chat.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback. Used only when GEMINI_API_KEY is empty.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini

# First run: leave blank, message your bot with /start to see your Telegram numeric ID,
# then place that ID here and restart. Example: 123456789
ALLOWED_TELEGRAM_USER_IDS=

# Poll RSS feeds every 15 minutes. Keep this moderate and respect feed providers' terms.
POLL_INTERVAL_MINUTES=15
MAX_NOTIFICATIONS_PER_CYCLE=4

# Local database path (relative paths are relative to the project folder)
DATABASE_PATH=./data/intel_radar.db

# Article digest window
DIGEST_HOURS=24

# Relevance and notifications
RADAR_HIGH_THRESHOLD=65
RADAR_MEDIUM_THRESHOLD=35
# Optional JSON object overriding the built-in keyword groups.
# RADAR_INTERESTS_JSON={"custom":["term one","term two"]}

# Optional public Telegram channel monitoring. Never put the BotFather token here.
# Obtain API credentials at https://my.telegram.org, then run telegram_login.py once
# from a terminal. The generated session file must remain private.
TELEGRAM_API_ID= 
TELEGRAM_API_HASH= 
TELEGRAM_SESSION_PATH=./data/telegram_user
TELEGRAM_CHANNEL_POLL_LIMIT=30
